// To-Do List Manager in C++
// A console-based program to add, view, complete and remove tasks.
 
#include <iostream>
#include <vector>
#include <string>
#include <limits>
#include <cstdlib>
 
using namespace std;
 
// Represents a single task
struct Task {
    string description;
    bool completed;
};
 
// Reads a valid integer from the user (handles non-numeric input)
int readInt(const string &prompt) {
    int value;
    while (true) {
        cout << prompt;
        if (cin >> value) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n'); // clear rest of line
            return value;
        }
        if (cin.eof()) {                                     // input stream closed
            cout << "\nNo more input. Exiting.\n";
            exit(0);
        }
        cout << "Invalid input! Please enter a number.\n";
        cin.clear();                                         // reset error state
        cin.ignore(numeric_limits<streamsize>::max(), '\n'); // discard bad input
    }
}
 
// Task Input + Add Task: asks for a description and adds it to the list
void addTask(vector<Task> &tasks) {
    string description;
 
    while (true) {
        cout << "Enter the task: ";
        getline(cin, description);
 
        if (cin.eof()) {
            cout << "\nNo more input. Exiting.\n";
            exit(0);
        }
        if (!description.empty()) {
            break;
        }
        cout << "Task cannot be empty! Please try again.\n";
    }
 
    Task newTask;
    newTask.description = description;
    newTask.completed = false;      // new tasks start as pending
    tasks.push_back(newTask);
 
    cout << "Task added successfully!\n";
}
 
// View Tasks: shows every task with its status
void viewTasks(const vector<Task> &tasks) {
    if (tasks.empty()) {
        cout << "\nYour to-do list is empty.\n";
        return;
    }
 
    cout << "\n------------- YOUR TASKS -------------\n";
    for (size_t i = 0; i < tasks.size(); i++) {
        cout << i + 1 << ". [" << (tasks[i].completed ? "Completed" : "Pending  ")
             << "] " << tasks[i].description << "\n";
    }
    cout << "--------------------------------------\n";
}
 
// Asks the user for a valid task number (returns index, or -1 if cancelled)
int chooseTask(const vector<Task> &tasks, const string &action) {
    viewTasks(tasks);
    if (tasks.empty()) {
        return -1;
    }
 
    while (true) {
        int number = readInt("Enter task number to " + action + " (0 to cancel): ");
 
        if (number == 0) {
            return -1;
        }
        if (number < 1 || number > static_cast<int>(tasks.size())) {
            cout << "Invalid task number! Choose between 1 and " << tasks.size() << ".\n";
            continue;
        }
        return number - 1;
    }
}
 
// Mark Task as Completed
void markCompleted(vector<Task> &tasks) {
    int index = chooseTask(tasks, "mark as completed");
    if (index == -1) {
        return;
    }
 
    if (tasks[index].completed) {
        cout << "That task is already completed.\n";
    } else {
        tasks[index].completed = true;
        cout << "Task marked as completed!\n";
    }
}
 
// Remove Task
void removeTask(vector<Task> &tasks) {
    int index = chooseTask(tasks, "remove");
    if (index == -1) {
        return;
    }
 
    cout << "Removed task: " << tasks[index].description << "\n";
    tasks.erase(tasks.begin() + index);
}
 
void displayMenu() {
    cout << "\n=====================================\n";
    cout << "          TO-DO LIST MANAGER         \n";
    cout << "=====================================\n";
    cout << "1. Add a task\n";
    cout << "2. View tasks\n";
    cout << "3. Mark a task as completed\n";
    cout << "4. Remove a task\n";
    cout << "5. Exit\n";
}
 
int main() {
    vector<Task> tasks;
    int choice;
 
    do {
        displayMenu();
        choice = readInt("Enter your choice (1-5): ");
 
        switch (choice) {
            case 1:
                addTask(tasks);
                break;
            case 2:
                viewTasks(tasks);
                break;
            case 3:
                markCompleted(tasks);
                break;
            case 4:
                removeTask(tasks);
                break;
            case 5:
                cout << "\nThanks for using the To-Do List Manager. Goodbye!\n";
                break;
            default:
                cout << "Invalid choice! Please choose between 1 and 5.\n";
        }
    } while (choice != 5);
 
    return 0;
}
